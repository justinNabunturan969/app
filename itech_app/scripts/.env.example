# scripts/.env.example
#
# Local-only credentials for the diagnostic scripts under /scripts.
# Copy to scripts/.env and fill in. scripts/.env is gitignored.
# Do NOT commit real values to the repo.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-real-anon-key...

# Run with:
#   node --env-file=scripts/.env scripts/check_inventory.mjs
# (Requires Node 20.6+. For older Node, use a dotenv loader or
#  set the variables inline: `SUPABASE_URL=... node scripts/check_inventory.mjs`.)
