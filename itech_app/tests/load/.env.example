# tests/load/.env.example
#
# Copy to .env and fill in. .env is gitignored.
# Do NOT commit real values to the repo.

SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...your-real-anon-key...

# Email domain used to synthesize fake student emails in scenario 01.
# The full email becomes loadtest+vu<id>@<STUDENT_DOMAIN>.
# Default if unset: pup.edu.ph
# STUDENT_DOMAIN=pup.edu.ph

# ───────────────────────────────────────────────────────────────────
# Scenario 02 (Realtime Live tab) needs ONE real student account
# that can sign in. The test signs them in repeatedly to generate
# active_sessions INSERT events for the admin subscriber to receive.
# Use a dedicated test account — do NOT use a real student's
# credentials.
# ───────────────────────────────────────────────────────────────────
STUDENT_EMAIL=loadtest+admin-driver@pup.edu.ph
STUDENT_PASSWORD=A_STRONG_PASSWORD_FOR_THE_TEST_ACCOUNT

# ───────────────────────────────────────────────────────────────────
# Scenario 03c (legit user blocked by shared-IP throttle) is
# OPTIONAL. Leave blank to skip the assertion.
# ───────────────────────────────────────────────────────────────────
# LEGIT_EMAIL=loadtest+legit@pup.edu.ph
# LEGIT_PASSWORD=A_DIFFERENT_STRONG_PASSWORD
